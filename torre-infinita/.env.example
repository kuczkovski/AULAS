# Copie para .env.local e preencha com os dados do projeto Supabase
# (Project Settings > API). Sem essas variáveis o jogo roda em modo local:
# o progresso fica só no navegador e não há ranking nem painel do professor.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
