# Copie para .env.local e preencha com os dados do projeto Supabase
# (Project Settings > API). Sem essas variáveis a ferramenta roda em modo local,
# só para testar a interface: tudo fica no navegador e o painel não exige login.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica
