{
  "name": "treino-full-body",
  "version": "1.0.0",
  "private": true,
  "description": "PWA para acompanhar um programa Full Body de quatro dias semanais",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/generate-sw.mjs",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "next": "^16.3.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vitest": "^5.0.2"
  }
}
